---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { ui } from "../lib/i18n";
import { siteProfile } from "../lib/site-data";
import type { Language } from "../lib/types";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const labels = ui[lang];
const headerCopy = {
  zh: { home: "糍粑 CIBA 首页", navigation: "主要导航" },
  en: { home: "CIBA home", navigation: "Primary navigation" },
  ja: { home: "糍粑 CIBA ホーム", navigation: "主要ナビゲーション" }
}[lang];
---

<header class="site-header">
  <a class="brand-mark" href={`/${lang}/`} aria-label={headerCopy.home}>
    <span>糍粑</span>
    <span>CIBA</span>
  </a>
  <nav class="site-nav" aria-label={headerCopy.navigation}>
    <a href={`/${lang}/works/`}>{labels.works}</a>
    <a href={`/${lang}/about/`}>{labels.about}</a>
    <a href={siteProfile.email ? `mailto:${siteProfile.email}` : `/${lang}/about/#contact`}>{labels.contact}</a>
  </nav>
  <LanguageSwitcher lang={lang} />
</header>
