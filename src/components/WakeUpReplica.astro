---
import ProjectImage from "./ProjectImage.astro";
import { getLocalizedMedia, getLocalizedString, getLocalizedStringList } from "../lib/projects";
import type { Language, LocalizedText, Project, ProjectMedia } from "../lib/types";

interface Props {
  project: Project;
  localized: LocalizedText;
  lang: Language;
}

const { project, localized, lang } = Astro.props;
const media = (name: string): ProjectMedia =>
  project.media.find((item) => item.src.includes(`/${name}.`)) ?? project.media[0];
const bedAlarm = media("bed-alarm");
const floodedTitle = media("flooded-title");
const displayedMedia = [bedAlarm, floodedTitle];
const localizedTags = getLocalizedStringList(project.tags, lang);
const localizedDetails = project.details ? {
  role: getLocalizedString(project.details.role, lang),
  scale: getLocalizedString(project.details.scale, lang),
  platform: getLocalizedString(project.details.platform, lang),
  credits: getLocalizedStringList(project.details.credits, lang)
} : undefined;
const copy = {
  zh: { back: "返回作品", record: "项目记录", year: "年份", medium: "媒介", tags: "标签", role: "角色", scale: "形式", platform: "平台", credits: "协作与署名", descriptions: "图像描述索引", descriptionsIntro: "两张公开图像按页面顺序列出；其他源素材保存在非公开归档中。", archive: "查看旧站档案" },
  en: { back: "Back to works", record: "Project record", year: "Year", medium: "Medium", tags: "Tags", role: "Role", scale: "Format", platform: "Platform", credits: "Credits", descriptions: "Image description index", descriptionsIntro: "The two public images are listed in page order; other source media is preserved in a non-deployable archive.", archive: "View previous-site archive" },
  ja: { back: "作品一覧へ戻る", record: "作品記録", year: "年", medium: "メディア", tags: "タグ", role: "役割", scale: "形式", platform: "プラットフォーム", credits: "クレジット", descriptions: "画像説明インデックス", descriptionsIntro: "公開する2点をページ順に示します。その他の素材は非公開アーカイブに保存しています。", archive: "旧サイトのアーカイブを見る" }
}[lang];
---

<article class="wake-replica" data-wake-page>
  <header class="wake-record-intro">
    <a class="wake-back" href={`/${lang}/works/`} aria-label={copy.back}>← WORKS</a>
    <div class="wake-record-intro__grid">
      <div>
        <p class="wake-record-intro__eyebrow">{localized.status ?? project.status} / {copy.record}</p>
        <h1>{localized.title}</h1>
        <p class="wake-record-intro__summary">{localized.summary}</p>
      </div>
      <div class="wake-record-intro__record">
        <dl>
          <div><dt>{copy.year}</dt><dd>{project.year}</dd></div>
          <div><dt>{copy.medium}</dt><dd>{localized.medium ?? project.medium}</dd></div>
          <div><dt>{copy.tags}</dt><dd>{localizedTags.join(" / ")}</dd></div>
          {localizedDetails?.role && <div><dt>{copy.role}</dt><dd>{localizedDetails.role}</dd></div>}
          {localizedDetails?.scale && <div><dt>{copy.scale}</dt><dd>{localizedDetails.scale}</dd></div>}
          {localizedDetails?.platform && <div><dt>{copy.platform}</dt><dd>{localizedDetails.platform}</dd></div>}
          {localizedDetails && localizedDetails.credits.length > 0 && <div><dt>{copy.credits}</dt><dd>{localizedDetails.credits.join(" / ")}</dd></div>}
        </dl>
        {localized.body.map((paragraph) => <p>{paragraph}</p>)}
        {project.links.archive && <a href={project.links.archive} target="_blank" rel="noreferrer">{copy.archive} ↗</a>}
      </div>
    </div>
    <details class="wake-record-intro__descriptions">
      <summary>{copy.descriptions}</summary>
      <p>{copy.descriptionsIntro}</p>
      <ol>{displayedMedia.map((item) => <li>{getLocalizedMedia(item, lang).alt}</li>)}</ol>
    </details>
  </header>

  <section class="wake-panel wake-opening wake-bed-panel" data-wake-panel>
    <ProjectImage class="wake-bed" media={bedAlarm} lang={lang} eager wake sizes="74vw" />
    <p class="wake-kicker">01 / {localized.title} / {project.year}</p>
  </section>

  <section class="wake-panel wake-opening wake-old-cover" data-wake-panel>
    <ProjectImage class="wake-cover-image" media={floodedTitle} lang={lang} wake sizes="100vw" />
    <p class="wake-kicker">02 / END</p>
  </section>
</article>
