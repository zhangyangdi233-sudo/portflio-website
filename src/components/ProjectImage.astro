---
import { getPublicImageMetadata } from "../lib/public-image-metadata";
import { getLocalizedMedia } from "../lib/projects";
import type { Language, ProjectMedia } from "../lib/types";

interface Props {
  media: ProjectMedia;
  lang: Language;
  eager?: boolean;
  decorative?: boolean;
  wake?: boolean;
  class?: string;
  sizes?: string;
  srcset?: string;
}

const {
  media,
  lang,
  eager = false,
  decorative = false,
  wake = false,
  class: className,
  sizes,
  srcset
} = Astro.props;
const { width, height } = await getPublicImageMetadata(media.src);
const localized = getLocalizedMedia(media, lang);
const wakeAttribute = wake ? { "data-wake-image": "" } : {};
// Local Figma exports need every image ready; published pages retain lazy loading.
const loadImmediately = eager || import.meta.env.DEV;
---

<img
  class={className}
  src={media.src}
  alt={decorative ? "" : localized.alt}
  width={width}
  height={height}
  style={`--media-aspect-ratio: ${width} / ${height}`}
  sizes={sizes}
  srcset={srcset}
  loading={loadImmediately ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
  aria-hidden={decorative ? "true" : undefined}
  {...wakeAttribute}
/>
