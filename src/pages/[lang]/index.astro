---
import { getCollection } from "astro:content";
import ProjectImage from "../../components/ProjectImage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildHomeComposition, homeMediaLayouts } from "../../lib/home-composition";
import { assertLanguage, languages } from "../../lib/i18n";
import { getLocalizedMedia, getLocalizedProject } from "../../lib/projects";
import { getLocalizedProfile, siteProfile } from "../../lib/site-data";
import type { Project } from "../../lib/types";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = assertLanguage(Astro.params.lang);
const profile = getLocalizedProfile(lang);
const entries = await getCollection("projects");
const projects = buildHomeComposition(entries.map((entry) => entry.data as Project));
const projectCount = String(projects.length).padStart(2, "0");
const copy = {
  zh: {
    role: "游戏 / 网页 / 影像",
    enter: "查看作品",
    selected: "作品",
    selectedNote: "五项公开记录：两件开发中的游戏、两件 2023 年网页作品，以及一组大学课题练习。",
    concept: "概念 / CONCEPT",
    record: "打开项目记录",
    imageHint: "桌面端单击图像切换预设位置，也可拖动；方向键移动，Home 复位。悬浮或键盘聚焦时显示彩色。",
    index: "作品索引",
    indexNote: "标题 / 年份 / 媒介 / 状态"
  },
  en: {
    role: "Games / Web / Moving image",
    enter: "View works",
    selected: "Works",
    selectedNote: "Five records are public: two games in development, two web-based works from 2023, and one university coursework archive.",
    concept: "CONCEPT",
    record: "Open project record",
    imageHint: "On desktop, click an image to cycle preset positions or drag it; use arrow keys to move and Home to reset. Hover or focus reveals colour.",
    index: "Works index",
    indexNote: "Title / year / medium / status"
  },
  ja: {
    role: "ゲーム / ウェブ / 映像",
    enter: "作品を見る",
    selected: "作品",
    selectedNote: "開発中のゲーム2点、2023年のウェブ作品2点、大学課題の記録1点を公開しています。",
    concept: "コンセプト",
    record: "作品記録を開く",
    imageHint: "デスクトップでは画像をクリックしてプリセット位置を切り替えるか、ドラッグできます。矢印キーで移動し、Homeで復位します。ホバーまたはフォーカスでカラー表示になります。",
    index: "作品索引",
    indexNote: "題名 / 年 / メディア / 状態"
  }
}[lang];

const letters = (value: string) => Array.from(value);
const composeTitleWords = (value: string) => {
  let letterIndex = 0;
  return value.trim().split(/\s+/).filter(Boolean).map((word) => ({
    word,
    letters: Array.from(word).map((letter) => ({ letter, index: letterIndex++ }))
  }));
};
---

<BaseLayout
  lang={lang}
  title={`${siteProfile.artistName} | ${profile.role}`}
  description={profile.statement[0]}
  pageClass="home-page ciba-home-v3"
>
  <section class="v3-home-hero" aria-labelledby="v3-home-title" data-v3-hero>
    <h1 class="v3-monument" id="v3-home-title" aria-label="CIBA" data-v3-letter-title>
      {
        letters("CIBA").map((letter, index) => (
          <span class="v3-letter-mask" aria-hidden="true" style={`--letter-index:${index}`}>
            <span class="v3-letter-track"><span>{letter}</span><span>{letter}</span></span>
          </span>
        ))
      }
    </h1>

    <div class="v3-home-hero__footer">
      <div>
        <p class="v3-home-hero__role">{copy.role}</p>
      </div>
      <a class="v3-action-link" href={`/${lang}/works/`}>
        <span>{copy.enter}</span><span aria-hidden="true">↘</span>
      </a>
    </div>

    <div class="v3-home-hero__signal" aria-hidden="true"><span>01</span><span>{projectCount}</span></div>
  </section>

  <section class="v3-cinema" aria-labelledby="v3-selected-title" data-v3-cinema>
    <header class="v3-section-heading">
      <p>01—{projectCount}</p>
      <h2 id="v3-selected-title">{copy.selected}</h2>
      <p>{copy.selectedNote}</p>
    </header>

    <div class="v3-cinema__scroll">
      <div class="v3-cinema__sticky" data-v3-cinema-stage>
        <p class="v3-cinema__hint">{copy.imageHint}</p>
        <p class="sr-only" id="v3-media-instruction">{copy.imageHint}</p>
        <div class="v3-cinema__layers">
          {
            projects.map((project, index) => {
              const localized = getLocalizedProject(project, lang);
              const number = String(index + 1).padStart(2, "0");
              const titleWords = composeTitleWords(localized.title.toUpperCase());
              const hasEditorialBreak =
                titleWords.length > 1 &&
                (project.slug === "escape-project" || project.slug === "university-coursework");
              return (
                <article
                  class:list={["v3-cinema-layer", { "is-active": index === 0 }]}
                  data-v3-cinema-layer
                  data-work-index={index}
                  aria-hidden={index === 0 ? "false" : "true"}
                >
                  <div class="v3-cinema-layer__meta">
                    <span>{number} / {projectCount}</span>
                    {project.year !== "—" && <span>{project.year}</span>}
                    <span>{localized.medium ?? project.medium}</span>
                    <span>{localized.status ?? project.status}</span>
                  </div>

                  <h3
                    class:list={["v3-cinema-layer__title", { "has-editorial-break": hasEditorialBreak }]}
                    aria-label={localized.title}
                    data-v3-letter-title
                    data-title-slug={project.slug}
                  >
                    {
                      titleWords.map(({ word, letters: wordLetters }, wordIndex) => (
                        <span
                          class="v3-title-word"
                          data-title-word={wordIndex + 1}
                          data-word={word}
                          aria-hidden="true"
                        >
                          {
                            wordLetters.map(({ letter, index: glyphIndex }) => (
                              <span class="v3-letter-mask" style={`--letter-index:${glyphIndex}`}>
                                <span class="v3-letter-track"><span>{letter}</span><span>{letter}</span></span>
                              </span>
                            ))
                          }
                        </span>
                      ))
                    }
                  </h3>

                  <div class="v3-cinema-layer__media" aria-label={`${localized.title}: ${copy.imageHint}`}>
                    {
                      project.homeMedia.map((media, mediaIndex) => {
                        const position = homeMediaLayouts[mediaIndex];
                        const localizedMedia = getLocalizedMedia(media, lang);
                        return (
                          <figure
                            class="v3-floating-media"
                            data-v3-floating-media
                            tabindex="0"
                            aria-label={localizedMedia.alt}
                            aria-describedby="v3-media-instruction"
                            aria-keyshortcuts="Enter Space ArrowLeft ArrowRight ArrowUp ArrowDown Shift+ArrowLeft Shift+ArrowRight Shift+ArrowUp Shift+ArrowDown Home"
                            style={`--media-x:${position.x};--media-y:${position.y};--media-w:${position.w};--media-r:${position.r}deg;--media-z:${mediaIndex + 1}`}
                          >
                            <ProjectImage
                              media={media}
                              lang={lang}
                              eager={index === 0 && mediaIndex === 0}
                              sizes="(max-width: 899px) calc(100vw - 2rem), 72vw"
                            />
                            <figcaption>{number}.{String(mediaIndex + 1).padStart(2, "0")} / {localizedMedia.caption ?? localizedMedia.alt}</figcaption>
                          </figure>
                        );
                      })
                    }
                  </div>

                  <div class="v3-cinema-layer__concept">
                    <p>{copy.concept}</p>
                    <p>{localized.summary}</p>
                  </div>

                  <a class="v3-cinema-layer__open" href={`/${lang}/works/${project.slug}/`}>
                    <span>{copy.record}</span><span aria-hidden="true">↗</span>
                  </a>
                </article>
              );
            })
          }
        </div>

        <div class="v3-cinema__counter" aria-live="polite">
          <span data-v3-cinema-current>01</span><span>/</span><span>{projectCount}</span>
        </div>
      </div>

      <div class="v3-cinema__triggers" aria-hidden="true">
        {projects.map((project, index) => <div data-v3-cinema-trigger data-work-index={index} data-slug={project.slug}></div>)}
      </div>
    </div>
  </section>

  <section class="v3-home-index" aria-labelledby="v3-index-title">
    <header class="v3-section-heading">
      <p>INDEX</p>
      <h2 id="v3-index-title">{copy.index}</h2>
      <p>{copy.indexNote}</p>
    </header>
    <div class="v3-home-index__list">
      {
        projects.map((project, index) => {
          const localized = getLocalizedProject(project, lang);
          return (
            <a href={`/${lang}/works/${project.slug}/`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{localized.title}</strong>
              <span>{project.year === "—" ? "" : project.year}</span>
              <span>{localized.medium ?? project.medium}</span>
              <span>{localized.status ?? project.status}</span>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
