---
import { getCollection } from "astro:content";
import WorkDesktopWindow from "../../../components/WorkDesktopWindow.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { artDirection, getWorkspacePosition } from "../../../lib/art-direction";
import { assertLanguage, languages, ui } from "../../../lib/i18n";
import { getLocalizedProject, getPublishedProjects } from "../../../lib/projects";
import { getLocalizedProfile, siteProfile } from "../../../lib/site-data";
import type { Project } from "../../../lib/types";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = assertLanguage(Astro.params.lang);
const labels = ui[lang];
const profile = getLocalizedProfile(lang);
const projectEntries = await getCollection("projects");
const projects = getPublishedProjects(projectEntries.map((entry) => entry.data as Project));
const projectCount = String(projects.length).padStart(2, "0");
const workspaceCopy = {
  zh: {
    title: "作品",
    desk: "桌面",
    intro: `${projects.length} 件可验证作品作为可移动窗口同时出现。拖动、叠放，或切换为列表顺序阅读。`,
    hint: "拖拽标题栏 · 方向键移动 · Esc 收入程序坞",
    workspace: "作品窗口工作区",
    filters: "作品筛选",
    scatter: "散布",
    scan: "列表",
    reset: "重置",
    dock: "项目窗口恢复栏",
    visible: "可见",
    layout: "窗口排列"
  },
  en: {
    title: "Works",
    desk: "Desktop",
    intro: `${projects.length} verified works surface as movable windows. Drag, overlap, or switch to List for an ordered reading.`,
    hint: "Drag title bar · Arrow keys move · Escape sends to dock",
    workspace: "Project window workspace",
    filters: "Work filters",
    scatter: "Scatter",
    scan: "List",
    reset: "Reset",
    dock: "Project window restore bar",
    visible: "visible",
    layout: "Window layout"
  },
  ja: {
    title: "作品",
    desk: "デスクトップ",
    intro: `検証できる${projects.length}件の作品を可動式ウィンドウとして表示します。重ねて比較するか、リストで順番に読めます。`,
    hint: "タイトルバーをドラッグ · 矢印キーで移動 · Escでドックへ",
    workspace: "作品ウィンドウ・ワークスペース",
    filters: "作品フィルター",
    scatter: "散布",
    scan: "リスト",
    reset: "リセット",
    dock: "作品ウィンドウ復元バー",
    visible: "表示",
    layout: "ウィンドウ配置"
  }
}[lang];
---

<BaseLayout
  lang={lang}
  title={`${labels.works} | ${siteProfile.artistName}`}
  description={profile.statement[0]}
  pageClass="works-page works-workspace-page"
>
  <section class="workspace-intro" data-motion="hero" aria-labelledby="works-title">
    <p class="workspace-intro__eyebrow">INDEX / {projectCount}</p>
    <h1 id="works-title" class="split-heading">{workspaceCopy.title}</h1>
    <p class="workspace-intro__desk" aria-hidden="true">/ {workspaceCopy.desk}</p>
    <div class="workspace-intro__copy">
      <p>{workspaceCopy.intro}</p>
      <p class="workspace-intro__hint">{workspaceCopy.hint}</p>
    </div>
    <p class="workspace-intro__count" aria-label={`${projectCount} ${labels.works}`}>
      <span>{projectCount}</span><span>OBJECTS</span>
    </p>
  </section>

  <section
    class="workspace-shell"
    aria-label={workspaceCopy.workspace}
    data-workspace-root
    style={`--workspace-height:${artDirection.workspace.stageHeight}px;`}
  >
    <div class="workspace-toolbar">
      <div class="workspace-toolbar__group" role="group" aria-label={workspaceCopy.filters}>
        <button type="button" data-workspace-filter="all" aria-pressed="true">{labels.all}</button>
        <button type="button" data-workspace-filter="featured" aria-pressed="false">{labels.featured}</button>
        <button type="button" data-workspace-filter="archive" aria-pressed="false">{labels.archive}</button>
      </div>

      <span class="workspace-toolbar__spacer" aria-hidden="true"></span>

      <div class="workspace-toolbar__group" role="group" aria-label={workspaceCopy.layout}>
        <button type="button" data-layout="scatter" aria-pressed="true">{workspaceCopy.scatter}</button>
        <button type="button" data-layout="scan" aria-pressed="false">{workspaceCopy.scan}</button>
        <button type="button" data-workspace-reset>{workspaceCopy.reset}</button>
      </div>

      <p
        class="workspace-toolbar__status"
        data-workspace-status
        data-visible-label={workspaceCopy.visible}
        aria-live="polite"
      >
        {projectCount} / {projectCount} {workspaceCopy.visible}
      </p>
    </div>

    <div class="workspace-stage" data-workspace-stage>
      {
        projects.map((project, index) => (
          <WorkDesktopWindow
            project={project}
            lang={lang}
            index={index}
            position={getWorkspacePosition(project.slug, index)}
          />
        ))
      }
    </div>

    <nav class="workspace-dock" aria-label={workspaceCopy.dock}>
      {
        projects.map((project, index) => {
          const localized = getLocalizedProject(project, lang);
          return (
            <button
              type="button"
              data-window-restore={project.slug}
              aria-pressed="true"
              title={localized.title}
            >
              {String(index + 1).padStart(2, "0")} / {localized.title}
            </button>
          );
        })
      }
    </nav>
  </section>
</BaseLayout>
