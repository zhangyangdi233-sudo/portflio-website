---
import Header from "../components/Header.astro";
import { getArtDirectionVars } from "../lib/art-direction";
import { siteProfile } from "../lib/site-data";
import type { Language } from "../lib/types";
import "../styles/global.css";
import "../styles/art-direction.css";
import "../styles/ciba-v3.css";

interface Props {
  lang: Language;
  title: string;
  description: string;
  pageClass?: string;
  theme?: Record<string, string>;
  bare?: boolean;
}

const { lang, title, description, pageClass = "", theme = {}, bare = false } = Astro.props;
const skipCopy = { zh: "跳到主要内容", en: "Skip to main content", ja: "本文へ移動" }[lang];
const themeStyle = Object.entries({ ...getArtDirectionVars(), ...theme })
  .map(([key, value]) => `${key}:${value}`)
  .join(";");
---

<!doctype html>
<html lang={lang} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090a08" />
    <title>{title}</title>
    {import.meta.env.DEV && <script is:inline src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>}
  </head>
  <body class:list={["ciba-v3", pageClass]}>
    <a class="skip-link" href="#content">{skipCopy}</a>
    {!bare && <div class="ambient-grid" aria-hidden="true"></div>}
    {!bare && <Header lang={lang} />}
    <main id="content">
      <slot />
    </main>
    {
      !bare && (
        <footer class="site-footer">
          <span>{siteProfile.artistName}</span>
          {
            siteProfile.email ? (
              <a href={`mailto:${siteProfile.email}`}>{siteProfile.email}</a>
            ) : siteProfile.socials[0] ? (
              <a href={siteProfile.socials[0].href} target="_blank" rel="noreferrer">{siteProfile.socials[0].label}</a>
            ) : null
          }
          <span>{siteProfile.location}</span>
        </footer>
      )
    }
    <script>
      import "../scripts/portfolio-motion";
    </script>
  </body>
</html>
